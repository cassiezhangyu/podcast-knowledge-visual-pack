   "isDeleted": false,
   "boundElements": null,
   "link": null,
   "locked": false,
   "updated": 1,
   "seed": 438,
   "text": "按自己的问题选一个。它们互补，不构成固定五步。",
   "fontSize": 24,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "按自己的问题选一个。它们互补，不构成固定五步。",
