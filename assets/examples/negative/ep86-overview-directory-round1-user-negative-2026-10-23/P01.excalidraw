   "isDeleted": false,
   "boundElements": null,
   "link": null,
   "locked": false,
   "updated": 1,
   "seed": 437,
   "text": "这是交付过程，不是四个需求的步骤。",
   "fontSize": 24,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "这是交付过程，不是四个需求的步骤。",
   "autoResize": false,
   "lineHeight": 1.25,
   "customData": {
    "typography_role": "body"
   }
  },
  {
   "id": "A_t_0438",
   "type": "text",
   "x": 80,
   "y": 558.0,
   "width": 576.08,
   "height": 30.0,
