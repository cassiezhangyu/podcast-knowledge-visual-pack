      "versionNonce": 100057,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "她举例：即使职场能力强，\n仍可能被说其它方面“不够”。",
      "fontSize": 26,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "她举例：即使职场能力强，\n仍可能被说其它方面“不够”。",
      "autoResize": true,
      "lineHeight": 1.25,
      "customData": {
        "typography_role": "body"
      }
    },
