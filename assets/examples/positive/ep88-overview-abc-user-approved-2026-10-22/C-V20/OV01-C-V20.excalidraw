illStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "roundness": null, "version": 1, "versionNonce": 266, "isDeleted": false, "boundElements": null, "link": null, "locked": false, "updated": 1, "seed": 266, "text": "土壤：知识体系", "fontSize": 32, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "土壤：知识体系", "autoResize": false, "lineHeight": 1.25, "customData": {"typography_role": "section_entry"}}, {"id": "C_t_0267", "type": "text", "x": 122.8, "y": 1054.0, "width": 237.44, "height": 40.0, "angle": 0, "strokeColor": "#235D9F", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "roundness": null, "version": 1, "versionNonce": 266, "isDeleted": false, "boundElements": null, "link": null, "locked": false, "updated": 1, "seed": 266, "text": "土壤：知识体系", "fontSize": 32, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "土壤：知识体系", "autoResize": false, "lineHeight": 1.25, "customData": {"typography_role": "section_entry", "dup": true}}, {"id": "C_t_0268", "type": "text", "x": 122, "y": 1096.0, "width": 474.24, "height": 30.0, "angle": 0, "strokeColor": "#1A4677", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "roundness": null, "version": 1, "versionNonce": 268, "isDeleted": false, "boundElements": null, "link": null, "locked": false, "updated": 1, "seed": 268, "text": "三步都靠它才能成立，但它本身不是第四步", "fontSize": 24, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "三步都靠它才能成立，但它本身不是第四步", "autoResize": false, "lineHeight": 1.25, "customData": {"typography_role": "body"}}, {"id": "C_t_0269", "type": "text", "x": 122, "y": 1128.0, "width": 499.20000000000005, "height": 60.0, "angle": 0, "strokeColor": "#273348", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "roundness": null, "version": 1, "versionNonce": 269, "isDeleted": false, "boundElements": null, "link": null, "locked": false, "updated": 1, "seed": 269, "text": "和旧知连上才活；知识要自己长成网，不是先\n搭框架再往里填；遇事能随时调出来。", "fontSize": 24, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "和旧知连上才活；知识要自己长成网，不是先\n搭框架再往里填；遇事能随时调出来。", "autoResize": false, "lineHeight": 1.25, "customData": {"typography_role": "body"}}, {"id": "C_ellipse_0270", "type": "ellipse", "x": 676, "y": 1058.0, "width": 32, "height": 32, "angle": 0, "strokeColor": "#235D9F", "backgroundColor": "#235D9F", "fillStyle": "solid", "strokeWidth": 2.4, "strokeStyle": "solid", "roughness": 1.4, "opacity": 100, "groupIds": [], "roundness": null, "version": 1, "versionNonce": 270, "isDeleted": false, "boundElements": null, "link": null, "locked": false, "updated": 1, "seed": 5135, "customData": {"stroke_role": "object_simple"}}, {"id": "C_t_0271", "type": "text", "x": 685.6382875, "y": 1060.25, "width": 21.12, "height": 27.5, "angle": 0, "strokeColor": "#FFFFFF", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "roundness": null, "version": 1, "versionNonce": 271, "isDeleted": false, "boundElements": null, "link": null, "locked": false, "updated": 1, "seed": 271, "text": "6", "fontSize": 22, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "6", "autoResize": false, "lineHeight": 1.25, "customData": {"typography_role": "annotation"}}, {"id": "C_t_0272", "type": "text", "x": 718, "y": 1054.0, "width": 172.8, "height": 40.0, "angle": 0, "strokeColor": "#235D9F", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opac