rId": null, "originalText": "带着兴趣去旅行", "autoResize": false, "lineHeight": 1.25, "customData": {"typography_role": "section_entry"}}, {"id": "A_t_0252", "type": "text", "x": 812.8, "y": 1239.88, "width": 237.44, "height": 40.0, "angle": 0, "strokeColor": "#346F64", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "roundness": null, "version": 1, "versionNonce": 251, "isDeleted": false, "boundElements": null, "link": null, "locked": false, "updated": 1, "seed": 251, "text": "带着兴趣去旅行", "fontSize": 32, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "带着兴趣去旅行", "autoResize": false, "lineHeight": 1.25, "customData": {"typography_role": "section_entry", "dup": true}}, {"id": "A_t_0253", "type": "text", "x": 772, "y": 1283.88, "width": 274.56, "height": 90.0, "angle": 0, "strokeColor": "#273348", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "roundness": null, "version": 1, "versionNonce": 253, "isDeleted": false, "boundElements": null, "link": null, "locked": false, "updated": 1, "seed": 253, "text": "不必全然陌生：把喜欢的\n古着店、书店、普拉提课\n带到新地方。", "fontSize": 24, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "不必全然陌生：把喜欢的\n古着店、书店、普拉提课\n带到新地方。", "autoResize": false, "lineHeight": 1.25, "customData": {"typography_role": "body"}}, {"id": "A_ellipse_0254", "type": "ellipse", "x": 80, "y": 1392.88, "width": 10, "height": 10, "angle": 0, "strokeColor": "#806477", "backgroundColor": "#806477", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1.6, "opacity": 100, "groupIds": [], "roundness": null, "version": 1, "versionNonce": 254, "isDeleted": false, "boundElements": null, "link": null, "locked": false, "updated": 1, "seed": 4831, "customData": {"stroke_role": "accent_d