op", "containerId": null, "originalText": "世界很大", "autoResize": false, "lineHeight": 1.25, "customData": {"typography_role": "body"}}, {"id": "C_t_0245", "type": "text", "x": 578.4799999999999, "y": 1335.8999999999999, "width": 105.6, "height": 30.0, "angle": 0, "strokeColor": "#273348", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "roundness": null, "version": 1, "versionNonce": 245, "isDeleted": false, "boundElements": null, "link": null, "locked": false, "updated": 1, "seed": 245, "text": "我的烦恼", "fontSize": 24, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "我的烦恼", "autoResize": false, "lineHeight": 1.25, "customData": {"typography_role": "body"}}, {"id": "C_t_0246", "type": "text", "x": 80, "y": 1307.22, "width": 444, "height": 30.0, "angle": 0, "strokeColor": "#273348", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "roundness": null, "version": 1, "versionNonce": 246, "isDeleted": false, "boundElements": null, "link": null, "locked": false, "updated": 1, "seed": 246, "text": "烟火气的 alive：日常里的热乎劲。", "fontSize": 24, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "烟火气的 alive：日常里的热乎劲。", "autoResize": false, "lineHeight": 1.25, "customData": {"typography_role": "body"}}, {"id": "C_t_0247", "type": "text", "x": 80, "y": 1341.22, "width": 444, "height": 60.0, "angle": 0, "strokeColor": "#273348", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "roundness": null, "version": 1, "versionNonce": 247, "isDeleted": false, "boundElements": null, "link": null, "locked": false, "updated": 1, "seed": 247, "text": "生命底层的唤醒：意识到世界很大，\n眼前的烦恼就小了（卫城、大海）。", "fontSize": 24, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "生命底层的唤醒：意识到世界很大，\n眼前的烦恼就小了（卫城、大海）。", "autoResize": false, "lineHeight": 1.25, "customData": {"typography_role": "body"}}, {"id": "C_ellipse_0248", "type": "ellipse", "x": 772, "y": 1266.22, "width": 30, "height": 30, "angle": 0, "strokeColor": "#346F64", "backgroundColor": "#346F64", "fillStyle": "solid", "strokeWidth": 2.4, "strokeStyle": "solid", "roughness": 1.4, "opacity": 100, "groupIds": [], "roundness": null, "version": 1, "versionNonce": 248, "isDeleted": false, "boundElements": null, "link": null, "locked": false, "updated": 1, "seed": 4717, "customData": {"stroke_role": "object_simple"}}, {"id": "C_t_0249", "type": "text", "x": 780.6382875, "y": 1267.47, "width": 21.12, "height": 27.5, "angle": 0, "strokeColor": "#FFFFFF", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "roundness": null, "version": 1, "versionNonce": 249, "isDeleted": false, "boundElements": null, "link": null, "locked": false, "updated": 1, "seed": 249, "text": "7", "fontSize": 22, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "7", "autoResize": false, "lineHeight": 1.25, "customData": {"typography_role": "annotation"}}, {"id": "C_t_0250", "type": "text", "x": 812, "y": 1263.22, "width": 237.44, "height": 40.0, "angle": 0, "strokeColor": "#346F64", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "roundness": null, "version": 1, "versionNonce": 250, "isDeleted": false, "boundElements": null, "link": null, "locked": false, "updated": 1, "seed": 250, "text": "带着兴趣去旅行", "fontSize": 32, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "带着兴趣去旅行", "autoResize": false, "lineHeight": 1.25, "customData": {"typography_role": "section_entry"}}, {"id": "C_t_0251", "type": "text", "x": 812.8, "y": 1263.22, "width": 237.44, "height": 40.0, "angle": 0, "strokeColor": "#346F64", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "roundness": null, "version": 1, "versionNonce": 250, "isDeleted": false, "boundElements": null, "link": null, "locked": false, "updated": 1, "seed": 250, "text": "带着兴趣去旅行", "fontSize": 32, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "带着兴趣去旅行", "autoResize": false, "lineHeight": 1.25, "customData": {"typography_role": "section_entry", "dup": true}}, {"id": "C_t_0252", "type": "text", "x": 772, "y": 1307.22, "width": 274.56, "height": 90.0, "angle": 0, "strokeColor": "#273348", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "roundness": null, "version": 1, "versionNonce": 252, "isDeleted": false, "boundElements": null, "link": null, "locked": false, "updated": 1, "seed": 252, "text": "不必全然陌生：把喜欢的\n古着店、书店、普拉提课\n带到新地方。", "fontSize": 24, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "不必全然陌生：把喜欢的\n古着店、书店、普拉提课\n带到新地方。", "autoResize": false, "lineHeight": 1.25, "customData": {"typography_role": "body"}}, {"id": "C_ellipse_0253", "type": "ellipse", "x": 80, "y": 1415.22, "width": 10, "height": 10, "angle": 0, "strokeColor": "#806477", "backgroundColor": "#806477", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1.6, "opacity": 100, "groupIds": [], "roundness": null, "version": 1, "versionNonce": 253, "isDeleted": false, "boundElements": null, "link": null, "locked": false, "updated": 1, "seed": 4812, "customData": {"stroke_role": "accent_detail"}}, {"id": "C_t_0254", "type": "text", "x": 100, "y": 1406.22, "width": 1020, "height": 27.5, "angle": 0,