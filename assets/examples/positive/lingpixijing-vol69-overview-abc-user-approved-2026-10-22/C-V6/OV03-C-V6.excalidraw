width": 38, "height": 1, "angle": 0, "strokeColor": "#9AA1AC", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2.2, "strokeStyle": "solid", "roughness": 0.8, "opacity": 100, "groupIds": [], "roundness": null, "version": 1, "versionNonce": 51, "isDeleted": false, "boundElements": null, "link": null, "locked": false, "updated": 1, "seed": 974, "customData": {"stroke_role": "connector"}, "points": [[0, 0], [38, 0]], "lastCommittedPoint": null, "startBinding": null, "endBinding": null, "startArrowhead": null, "endArrowhead": "arrow"}, {"id": "C_t_0052", "type": "text", "x": 80, "y": 386, "width": 324.48, "height": 90.0, "angle": 0, "strokeColor": "#27534B", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "roundness": null, "version": 1, "versionNonce": 52, "isDeleted": false, "boundElements": null, "link": null, "locked": false, "updated": 1, "seed": 52, "text": "被充电、没负担、不是被迫：\n心里像被重新启动，\n暂时跳出日常节奏。", "fontSize": 24, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "被充电、没负担、不是被迫：\n心里像被重新启动，\n暂时跳出日常节奏。", "autoResize": false, "lineHeight": 1.25, "customData": {"typography_role": "body"}}, {"id": "C_t_0053", "type": "text", "x": 80, "y": 556, "width": 548, "height": 30.0, "angle": 0, "strokeColor": "#273348", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "roundness": null, "version": 1, "versionNonce": 53, "isDeleted": false, "boundElements": null, "link": null, "locked": false, "updated": 1, "seed": 53, "text": "日子像流水线：按部就班，却好久没觉得有劲。", "fontSize": 24, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "日子像流水线：按部就班，却好久没觉得有劲。", "autoResize": false, "lineHeight": 1.25, "customData": {"typography_role": "body"}}, {"id": "C_line_0054", "type": "line", "x": 624, "y"