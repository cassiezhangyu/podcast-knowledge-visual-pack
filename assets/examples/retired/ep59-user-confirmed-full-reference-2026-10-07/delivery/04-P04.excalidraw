    {
      "id": "training_limits",
      "type": "text",
      "x": 80,
      "y": 1003,
      "width": 1040,
      "height": 33.800000000000004,
      "angle": 0,
      "strokeColor": "#94603F",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeStyle": "solid",
      "strokeWidth": 1,
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 47286,
      "version": 1,
      "versionNonce": 75628,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "customData": {
        "typography_role": "body"
      },
      "text": "训练重量、骨质疏松比例等节目说法尚未独立医学核实。",
      "originalText": "训练重量、骨质疏松比例等节目说法尚未独立医学核实。",
      "fontSize": 26,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": false,
      "lineHeight": 1.3
    },
    {
      "id": "personal_limits",
      "type": "text",
      "x": 80,
      "y": 1359,
      "width": 1040,
      "height": 67.60000000000001,
      "angle": 0,
      "strokeColor": "#94603F",
      "backgroundColor": "transparent",
