{
  "version": "0.5.0",
  "canvas": {
    "ratio": "3:4",
    "width": 1200,
    "height": 1600,
    "safe_margin": 80,
    "safe_left": 80,
    "safe_right": 1120,
    "top_visible_target": 64,
    "bottom_visible_target": 68,
    "outer_vertical_tolerance": 8,
    "right_text_inner_buffer": 20
  },
  "colors": {
    "background": "#FFFFFF",
    "surface_neutral": "#F8FAFB",
    "text_primary": "#273348",
    "text_secondary": "#6D7882",
    "line_weak": "#D2D9DE",
    "note": "主辅色只读本期 selected_palette.json；此处不提供主题色回退。"
  },
  "package_palette_policy": {
    "scope": "one_episode_package",
    "theme_colors": 2,
    "roles": [
      "primary",
      "secondary"
    ],
    "derive_for": [
      "cover",
      "overview",
      "deep_dives",
      "text_emphasis",
      "hero_surfaces",
      "rules"
    ],
    "selection_basis": [
      "episode_tone",
      "content_objects",
      "official_brand_asset"
    ],
    "constraints": [
      "select a fresh harmonious primary-secondary pair for each episode",
      "reuse semantic color roles across the whole package",
      "do not inherit the previous episode palette by default",
      "official album art keeps original colors but does not expand the content palette"
    ],
    "colors_field_is_fallback_only": true
  },
  "typography": {
    "font_family": "system-cjk-sans",
    "title": 45,
    "subtitle": 25,
    "section": 28,
    "module": 26,
    "body": 24,
    "annotation": 22,
    "min_readable": 22,
    "header_meta": 22,
    "footer_meta": 22,
    "role_sizes": {
      "cover_brand": 28,
      "cover_title": 62,
      "cover_hook": 42,
      "cover_support": 26,
      "overview_title": 45,
      "overview_thesis": 25,
      "overview_section": 28,
      "overview_body": 24,
      "deep_title": 45,
      "deep_thesis": 25,
      "section_entry": 30,
      "section": 28,
      "subheading": 26,
      "body": 24,
      "annotation": 22,
      "diagram_label": 23,
      "object_name": 27,
      "header_meta": 22,
      "footer_meta": 22,
      "page_conclusion": 32,
      "key_l1": 27,
      "key_lead": 32,
      "note_l2": 22,
      "caption_l3": 22
    },
    "strong_inner_roles": [
      "overview_title",
      "deep_title",
      "page_conclusion",
      "section_entry",
      "overview_section",
      "section",
      "subheading"
    ],
    "policy": "每个文字元素声明 typography_role；字号严格等于 role_sizes，同句跨行和同级并列使用同角色。容量不足调整布局，未经用户明确授权不缩小字号。"
  },
  "cover": {
    "background": "#FFFFFF",
    "palette_policy": {
      "theme_colors_per_episode": 2,
      "roles": [
        "primary",
        "secondary"
      ],
      "allow_new_pair_for_next_episode": true,
      "derive": [
        "primary_soft",
        "secondary_soft",
        "hero_background",
        "text_primary",
        "text_secondary",
        "line_weak"
      ],
      "constraints": [
        "colored text, diagram strokes and fills, hero background, and weak rules reuse the episode palette by semantic role",
        "hero background is a high-lightness low-saturation derivative, not a third theme color",
        "official album art keeps original colors but does not expand the page palette"
      ]
    },
    "reference_palette_e248": {
      "text_primary": "#273545",
      "text_secondary": "#6C7886",
      "primary": "#466C8B",
      "primary_soft": "#DCE7EF",
      "secondary": "#A56A2C",
      "secondary_soft": "#EFE3D4",
      "hero_background": "#EEF2F3",
      "line_weak": "#C8D1D8"
    },
    "safe_margin": {
      "min": 80,
      "preferred": 92
    },
    "type_scale": {
      "episode_title": {
        "min": 62,
        "max": 62,
        "weight_role": "heaviest"
      },
      "editorial_hook": {
        "min": 42,
        "max": 42,
        "weight_role": "strong"
      },
      "hook_support": {
        "min": 26,
        "max": 26,
        "weight_role": "secondary"
      },
      "hero_heading": {
        "min": 28,
        "max": 28,
        "weight_role": "secondary"
      },
      "hero_copy": {
        "min": 24,
        "max": 24,
        "weight_role": "supporting"
      },
      "keyword_value": {
        "min": 24,
        "max": 24,
        "weight_role": "supporting"
      },
      "appearance_meta": {
        "min": 22,
        "max": 22,
        "weight_role": "muted"
      }
    },
    "hierarchy": [
      "episode_title",
      "editorial_hook",
      "hero_diagram",
      "hook_support",
      "keywords",
      "appearance_and_duration"
    ],
    "hero_surface": {
      "role": "local_visual_anchor_only",
      "color_rule": "derive a high-lightness low-saturation color from the episode primary or coordinated primary-secondary mixture",
      "e248_example": "#EEF2F3",
      "full_page_mask_allowed": false,
      "overview_ghost_allowed": false
    },
    "brand_asset": {
      "scope": "all_pages",
      "box": {
        "x": 976,
        "y": 64,
        "width": 144,
        "height": 144
      },
      "official_album_art_only": true,
      "preserve_aspect_ratio": true,
      "preserve_original_colors": true,
      "scene_image_elements": 0,
      "scene_files_entries": 0,
      "final_composite_requires_sha256": true
    }
  },
  "stroke": {
    "primary": 2.8,
    "secondary": 2,
    "roughness": 2.0,
    "roughness_object": 2.0,
    "roughness_rule": 1.1,
    "roundness": "moderate",
    "role_settings": {
      "object": {
        "strokeWidth": 2.8,
        "roughness": 2.0
      },
      "detail": {
        "strokeWidth": 2,
        "roughness": 1.4
      },
      "relation": {
        "strokeWidth": 2.6,
        "roughness": 1.4
      },
      "connector": {
        "strokeWidth": 2.2,
        "roughness": 0.8
      },
      "emphasis": {
        "strokeWidth": 3.2,
        "roughness": 1.4
      },
      "heavy_detail": {
        "strokeWidth": 4.5,
        "roughness": 1.4
      },
      "rule": {
        "strokeWidth": 1.8,
        "roughness": 1.1
      },
      "surface": {
        "strokeWidth": 1.8,
        "roughness": 1.1
      },
      "fill_only": {
        "strokeWidth": 0,
        "roughness": 0
      },
      "frame": {
        "strokeWidth": 2,
        "roughness": 1.1
      },
      "accent_detail": {
        "strokeWidth": 2,
        "roughness": 1.6
      },
      "object_simple": {
        "strokeWidth": 2.4,
        "roughness": 1.4
      },
      "curve": {
        "strokeWidth": 2.6,
        "roughness": 0.9
      }
    },
    "policy": "按已通过样稿 examples/positive/ep88-p13-rough-stroke-accepted-2026-09-26 并排校准：信息框、排版横线与导航边界 roughness=1.1（frame/rule/surface），具体插图小对象 object 2.0；短语义关系箭头 relation 1.4、强调 emphasis 1.4（v0.6.0 由 2.0/1.6 下调，长路径上不再产生抖线）；细节 1.4、连接线 0.8。超过 path_limits 的长曲线／圆环／椭圆／长箭头一律 curve。颤抖感主要来自把信息框按插图对象（2.8）绘制——信息框一律用 frame 角色。不得出现整段平行双线，也不能低到失去手绘感。（2026-10-12 用户两次反馈后校准。） 曲线（圆弧、环形箭头）用 curve 角色：roughness 0.9、少量控制点并开启平滑（roundness type 2），单线；折线逐段叠加高 roughness 会显得颤抖。（2026-10-12 用户：“圆弧线条还是在抖”。）",
    "path_limits": {
      "max_points_per_path": 6,
      "long_path_px": 220,
      "long_path_max_roughness": 1.0,
      "large_ellipse_px": 60,
      "large_ellipse_max_roughness": 1.0,
      "rule": "长曲线、圆环弧、椭圆(>60px)、>220px 的箭头一律用 curve（0.9）且 ≤6 点；relation/emphasis/object 只用于短路径与小对象。这是 token 本身，不是事后修补；audit_stroke_shapes.py 读取本节。 排版横线／信息框（rule/surface/frame，1.1）是直线，不受长路径限制。",
      "long_path_exempt_roles": [
        "rule",
        "surface",
        "frame"
      ]
    }
  },
  "spacing": {
    "xs": 8,
    "sm": 14,
    "md": 24,
    "lg": 38,
    "xl": 58,
    "text_to_rule_min": 12,
    "text_to_object_line_min": 20
  },
  "semantics": {
