e": false, "lineHeight": 1.25, "customData": {"typography_role": "body"}}, {"id": "A15_t_0224", "type": "text", "x": 145.6, "y": 1068.88, "width": 320.32, "height": 55.0, "angle": 0, "strokeColor": "#3E4552", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "roundness": null, "version": 1, "versionNonce": 224, "isDeleted": false, "boundElements": null, "link": null, "locked": false, "updated": 1, "seed": 224, "text": "关注面越大机会越多；没美元账\n户不碰英伟达", "fontSize": 22, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "关注面越大机会越多；没美元账\n户不碰英伟达", "autoResize": false, "lineHeight": 1.25, "customData": {"typography_role": "annotation"}}, {"id": "A15_t_0225", "type": "text", "x": 505.2, "y": 1032.88, "width": 105.6, "height": 60.0, "angle": 0, "strokeColor": "#273348", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "roundness": null, "version": 1, "versionNonce": 225, "isDeleted": false, "boundElements": null, "link": null, "locked": false, "updated": 1, "seed": 225, "text": "温转热进\n温转平出", "fontSize": 24, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "温转热进\n温转平出", "autoResize": false, "lineHeight": 1.25, "customData": {"typography_role": "body"}}, {"id": "A15_t_0226", "type": "text", "x": 505.2, "y": 1098.88, "width": 140.8, "height": 27.5, "angle": 0, "strokeColor": "#3E4552", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "roundness": null, "version": 1, "versionNonce": 226, "isDeleted": false, "boundElements": null, "link": null, "locked": false, "updated": 1, "seed": 226, "text": "是事实非感觉", "fontSize": 22, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "or