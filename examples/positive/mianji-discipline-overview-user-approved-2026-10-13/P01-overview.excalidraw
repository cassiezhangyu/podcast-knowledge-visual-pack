, "updated": 1, "seed": 324, "text": "3", "fontSize": 22, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "3", "autoResize": false, "lineHeight": 1.25, "customData": {"typography_role": "annotation"}}, {"id": "A15_t_0325", "type": "text", "x": 972, "y": 1252, "width": 118.8, "height": 27.5, "angle": 0, "strokeColor": "#273348", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "roundness": null, "version": 1, "versionNonce": 325, "isDeleted": false, "boundElements": null, "link": null, "locked": false, "updated": 1, "seed": 325, "text": "打磨与守住", "fontSize": 22, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "打磨与守住", "autoResize": false, "lineHeight": 1.25, "customData": {"typography_role": "annotation"}}, {"id": "A15_t_0326", "type": "text", "x": 936, "y": 1292, "width": 166.76000000000002, "height": 55.0, "angle": 0, "strokeColor": "#8E939C", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "roundness": null, "version": 1, "versionNonce": 326, "isDeleted": false, "boundElements": null, "link": null, "locked": false, "updated": 1, "seed": 326, "text": "1→2 递进；3 补\n充与边界", "fontSize": 22, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "1→2 递进；3 补\n充与边界", "autoResize": false, "lineHeight": 1.25, "customData": {"typography_role": "annotation"}}, {"id": "A15_t_0327", "type": "text", "x": 936, "y": 1355.0, "width": 162.8, "height": 110.0, "angle": 0, "strokeColor": "#273348", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "roundness": null, "version": 1, "versionNonce": 327, "isDeleted": false, "boundElements": null, "link": null, "locked": false, "updated": 1, "seed": 327, "text": "怎么读：先看①\n拆开，再沿②从\n左往右走一遍，\n最后读③。", "fontSize": 22, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "怎么读：先看①\n拆开，再沿②从\n左往右走一遍，\n最后读③。", "autoResize": false, "lineHeight": 1.25, "customData": {"typography_role": "annotation"}}, {"id": "A15_rectangle_0328", "type": "rectangle", "x": 80, "y": 1424, "width": 803, "height": 60, "angle": 0, "strokeColor": "transparent", "backgroundColor": "#F8FAFB", "fillStyle": "solid", "strokeWidth": 0, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "roundness": null, "version": 1, "versionNonce": 328, "isDeleted": false, "boundElements": null, "link": null, "locked": false, "updated": 1, "seed": 6237, "customData": {"stroke_role": "fill_only"}}, {"id": "A15_rectangle_0329", "type": "rectangle", "x": 80, "y": 1424, "width": 5, "height": 60, "angle": 0, "strokeColor": "transparent", "backgroundColor": "#9B5A48", "fillStyle": "solid", "strokeWidth": 0, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "roundness": null, "version": 1, "versionNonce": 329, "isDeleted": false, "boundElements": null, "link": null, "locked": false, "updated": 1, "seed": 6256, "customData": {"stroke_role": "fill_only"}}, {"id": "A15_t_0330", "type": "text", "x": 96, "y": 1427, "width": 640.64, "height": 27.5, "angle": 0, "strokeColor": "#6E3C2F", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "roundness": null, "version": 1, "versionNonce": 330, "isDeleted": false, "boundElements": null, "link": null, "locked": false, "updated": 1, "seed": 330, "text": "提醒：不构成投资建议。纪律没有高下，只是风格，不是圣杯。", "fontSize": 22, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "提醒：不构成投资建议。纪律没有高下，只是风格，不是圣杯。", "autoResize": false, "lineHeight": 1.25, "customData": {"typography_role": "annotation"}}, {"id": "A15_t_0331", "type": "text", "x": 96, "y": 1455, "width": 709.28, "height": 27.5, "angle": 0, "strokeColor": "#3E4552", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "roundness": null, "version": 1, "versionNonce": 331, "isDeleted": false, "boundElements": null, "link": null, "locked": false, "updated": 1, "seed": 331, "text": "乌鲁木齐买房等只是方法演示；私人纪律不能照抄，尤其不适合小白。", "fontSize": 22, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "乌鲁木齐买房等只是方法演示；私人纪律不能照抄，尤其不适合小白。", "autoResize": false, "lineHeight": 1.25, "customData": {"typography_role": "annotation"}}], "appState": {"viewBackgroundColor": "#FFFFFF", "gridSize": null, "width": 1200, "height": 1600}, "files": {}}