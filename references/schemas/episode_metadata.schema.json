{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EpisodeMetadata",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source_identity", "episode", "source_refs"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "source_identity": {
      "type": "object", "additionalProperties": false,
      "required": ["canonical_url", "adapter_version"],
      "properties": {"canonical_url": {"type": "string", "format": "uri"}, "adapter_version": {"type": "string"}}
    },
    "episode": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "title", "podcast_name", "published_at", "duration_seconds", "show_notes", "cover_url", "audio_candidates"],
      "properties": {
        "id": {"type": "string", "minLength": 1}, "title": {"type": ["string", "null"]},
        "podcast_name": {"type": ["string", "null"]}, "published_at": {"type": ["string", "null"]},
        "duration_seconds": {"type": ["number", "null"], "minimum": 0}, "show_notes": {"type": ["string", "null"]},
        "cover_url": {"type": ["string", "null"]}, "audio_candidates": {"type": "array", "items": {"type": "string", "format": "uri"}}
      }
    },
    "source_refs": {"type": "array", "minItems": 1, "items": {"$ref": "source_ref.schema.json"}}
  }
}
