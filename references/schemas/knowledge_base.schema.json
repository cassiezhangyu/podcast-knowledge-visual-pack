{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KnowledgeBase",
  "oneOf": [
    {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "KnowledgeBaseV1Legacy",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "kind",
        "status",
        "cache_key",
        "input",
        "execution",
        "windows",
        "units",
        "coverage_audit"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "kind": {
          "const": "knowledge_base"
        },
        "status": {
          "enum": [
            "partial",
            "completed"
          ]
        },
        "cache_key": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "input": {
          "type": "object",
          "required": [
            "audio_sha256",
            "grounded_transcript_sha256",
            "corrections_sha256"
          ],
          "properties": {
            "audio_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "grounded_transcript_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "corrections_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        "execution": {
          "type": "object",
          "required": [
            "kind",
            "model_id",
            "runtime_id",
            "identity_status"
          ],
          "properties": {
            "kind": {
              "const": "current_skill_execution_model"
            },
            "model_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "runtime_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "identity_status": {
              "enum": [
                "reported_by_host",
                "not_exposed_by_host"
              ]
            }
          }
        },
        "windows": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object"
          }
        },
        "units": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "coverage_audit": {
          "type": "object",
          "required": [
            "total_spans",
            "bands"
          ],
          "properties": {
            "total_spans": {
              "type": "integer",
              "minimum": 1
            },
            "bands": {
              "type": "array",
              "minItems": 1
            }
          }
        }
      }
    },
    {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "KnowledgeBaseV2",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "kind",
        "status",
        "cache_key",
        "input",
        "execution",
        "episode_content_inventory_sha256",
        "windows",
        "units",
        "reconciliation_decisions"
      ],
      "properties": {
        "schema_version": {
          "const": "2.0"
        },
        "kind": {
          "const": "knowledge_base"
        },
        "status": {
          "enum": [
            "partial",
            "completed"
          ]
        },
        "cache_key": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "input": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "audio_sha256",
            "grounded_transcript_sha256",
            "corrections_sha256"
          ],
          "properties": {
            "audio_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "grounded_transcript_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "corrections_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        "execution": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "model_id",
            "runtime_id",
            "identity_status"
          ],
          "properties": {
            "kind": {
              "const": "current_skill_execution_model"
            },
            "model_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "runtime_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "identity_status": {
              "enum": [
                "reported_by_host",
                "not_exposed_by_host"
              ]
            }
          }
        },
        "episode_content_inventory_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "windows": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object"
          }
        },
        "units": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "content_unit_id",
              "title",
              "summary",
              "importance",
              "evidence_anchor_ids",
              "claims",
              "mechanisms",
              "supporting_details",
              "examples",
              "concrete_objects",
              "actions",
              "conditions",
              "boundaries",
              "counterpoints",
              "uncertainties"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^ku_"
              },
              "content_unit_id": {
                "type": "string",
                "pattern": "^cu_"
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "summary": {
                "type": "string",
                "minLength": 20
              },
              "importance": {
                "enum": [
                  "core",
                  "supporting",
                  "context"
                ]
              },
              "evidence_anchor_ids": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string"
                }
              },
              "claims": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "mechanisms": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "examples": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "concrete_objects": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "actions": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "conditions": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "boundaries": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "counterpoints": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "uncertainties": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "supporting_details": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "detail_id",
                    "statement",
                    "kind",
                    "importance",
                    "evidence_anchor_ids"
                  ],
                  "properties": {
                    "detail_id": {
                      "type": "string",
                      "pattern": "^det_"
                    },
                    "statement": {
                      "type": "string",
                      "minLength": 1
                    },
                    "kind": {
                      "enum": [
                        "support",
                        "example",
                        "object_action",
                        "condition",
                        "boundary",
                        "counterpoint",
                        "context"
                      ]
                    },
                    "importance": {
                      "enum": [
                        "core",
                        "supporting",
                        "context"
                      ]
                    },
                    "evidence_anchor_ids": {
                      "type": "array",
                      "minItems": 1,
                      "uniqueItems": true,
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "reconciliation_decisions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "source_unit_ids",
              "decision",
              "rationale"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^rec_"
              },
              "source_unit_ids": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^cu_"
                }
              },
              "decision": {
                "enum": [
                  "kept_separate",
                  "merged",
                  "linked",
                  "context_only",
                  "excluded_with_reason"
                ]
              },
              "rationale": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  ]
}
