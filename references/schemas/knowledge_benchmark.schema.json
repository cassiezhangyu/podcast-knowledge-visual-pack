{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KnowledgeUnderstandingValidation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "status", "input", "windows", "evaluation"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "kind": {"const": "knowledge_provider_benchmark"},
    "status": {"enum": ["prepared", "completed", "current_skill_model_validation"]},
    "input": {"type": "object", "required": ["audio_sha256", "grounded_transcript_sha256"], "properties": {"audio_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "grounded_transcript_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}},
    "provider": {"type": ["object", "null"]},
    "windows": {"type": "array", "minItems": 3, "items": {"type": "object", "required": ["id", "start_ms", "end_ms", "span_ids", "purpose"], "properties": {"id": {"type": "string"}, "start_ms": {"type": "integer", "minimum": 0}, "end_ms": {"type": "integer", "minimum": 0}, "span_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "purpose": {"type": "array", "minItems": 1, "items": {"type": "string"}}}}},
    "evaluation": {"type": "object", "required": ["criteria", "full_golden_allowed"], "properties": {"criteria": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "full_golden_allowed": {"type": "boolean"}}}
  }
}
