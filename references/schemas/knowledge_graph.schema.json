{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KnowledgeGraph",
  "oneOf": [
    {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "KnowledgeGraphV1Legacy",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "kind",
        "status",
        "knowledge_base_sha256",
        "episode_thesis",
        "core_questions",
        "evidence_anchors",
        "nodes",
        "relationships",
        "coverage_audit"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "kind": {
          "const": "knowledge_graph"
        },
        "status": {
          "enum": [
            "partial",
            "completed"
          ]
        },
        "knowledge_base_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "episode_thesis": {
          "type": [
            "object",
            "null"
          ]
        },
        "core_questions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidence_anchors": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object"
          }
        },
        "nodes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "kind",
              "statement",
              "epistemic_status",
              "evidence_anchor_ids",
              "confidence",
              "review_status",
              "uncertainty"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^(clm|mech|ex|obs|bnd|ctr|q)_"
              },
              "kind": {
                "enum": [
                  "claim",
                  "mechanism",
                  "example",
                  "observation",
                  "boundary",
                  "counterpoint",
                  "core_question"
                ]
              },
              "statement": {
                "type": "string",
                "minLength": 1
              },
              "epistemic_status": {
                "enum": [
                  "speaker_explicit",
                  "source_explicit",
                  "episode_synthesis",
                  "model_inference"
                ]
              },
              "speaker_ref": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "evidence_anchor_ids": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              },
              "derived_from_ids": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "inference_basis": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "confidence": {
                "enum": [
                  "high",
                  "medium",
                  "low"
                ]
              },
              "uncertainty": {
                "type": "string"
              },
              "review_status": {
                "enum": [
                  "accepted",
                  "needs_human_review",
                  "rejected"
                ]
              },
              "high_impact": {
                "type": "boolean"
              }
            }
          }
        },
        "relationships": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "from_id",
              "to_id",
              "type",
              "direction",
              "epistemic_status",
              "evidence_anchor_ids",
              "confidence",
              "review_status"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^rel_"
              },
              "from_id": {
                "type": "string"
              },
              "to_id": {
                "type": "string"
              },
              "type": {
                "enum": [
                  "supports",
                  "explains",
                  "illustrates",
                  "qualifies",
                  "counters",
                  "contrasts",
                  "prerequisite",
                  "application",
                  "part_of",
                  "evolution"
                ]
              },
              "direction": {
                "enum": [
                  "directed",
                  "symmetric"
                ]
              },
              "epistemic_status": {
                "enum": [
                  "speaker_explicit",
                  "episode_synthesis",
                  "model_inference"
                ]
              },
              "evidence_anchor_ids": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              },
              "confidence": {
                "enum": [
                  "high",
                  "medium",
                  "low"
                ]
              },
              "review_status": {
                "enum": [
                  "accepted",
                  "needs_human_review",
                  "rejected"
                ]
              }
            }
          }
        },
        "coverage_audit": {
          "type": "object",
          "required": [
            "bands",
            "unit_dispositions"
          ],
          "properties": {
            "bands": {
              "type": "array",
              "minItems": 1
            },
            "unit_dispositions": {
              "type": "array"
            }
          }
        },
        "deduplication_decisions": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "relationship_decisions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "candidate_id",
              "status",
              "reason"
            ],
            "properties": {
              "candidate_id": {
                "type": "string"
              },
              "status": {
                "enum": [
                  "kept",
                  "rejected"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
