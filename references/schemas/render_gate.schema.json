{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RenderGate",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "kind", "status", "render_manifest_sha256", "checks", "human_review_required", "independent_review_required"],
  "properties": {
    "schema_version": {"const": "1.0"}, "kind": {"const": "render_gate"}, "status": {"enum": ["needs_human_review", "pass", "fail"]},
    "render_manifest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "checks": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["name", "status", "details"], "properties": {"name": {"type": "string"}, "status": {"enum": ["pass", "needs_human_review", "fail"]}, "details": {"type": "object"}}}},
    "human_review_required": {"type": "boolean"}, "independent_review_required": {"type": "boolean"}
  }
}
