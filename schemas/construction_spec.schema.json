{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ConstructionSpec",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "status", "input", "pages"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "kind": {"const": "construction_spec"},
    "status": {"const": "completed"},
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["episode_metadata_sha256", "editorial_plan_sha256", "selected_visual_plan_sha256", "visual_gate_sha256", "design_tokens_sha256"],
      "properties": {
        "episode_metadata_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "editorial_plan_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "selected_visual_plan_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "visual_gate_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "design_tokens_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "pages": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/page"}}
  },
  "$defs": {
    "intent": {
      "type": "object", "additionalProperties": false,
      "required": ["dominant_gesture", "visual_center_of_gravity", "scale_contrast", "density_rhythm", "directional_energy", "asymmetry_balance_intent", "local_irregularity_allowance"],
      "properties": {
        "dominant_gesture": {"type": "string", "minLength": 1}, "visual_center_of_gravity": {"type": "string", "minLength": 1},
        "scale_contrast": {"type": "string", "minLength": 1}, "density_rhythm": {"type": "string", "minLength": 1},
        "directional_energy": {"type": "string", "minLength": 1}, "asymmetry_balance_intent": {"type": "string", "minLength": 1},
        "local_irregularity_allowance": {"type": "string", "minLength": 1}
      }
    },
    "element": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "type", "x", "y", "width", "height", "role"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-zA-Z0-9:_-]+$"}, "type": {"enum": ["text", "rectangle", "ellipse", "line", "arrow"]},
        "x": {"type": "number"}, "y": {"type": "number"}, "width": {"type": "number", "minimum": 0}, "height": {"type": "number", "minimum": 0},
        "role": {"enum": ["page_chrome", "canvas_background", "hero_root", "semantic_object", "state_marker", "action_path", "key_label", "annotation", "boundary"]},
        "text": {"type": "string", "minLength": 1}, "font_size": {"type": "number", "minimum": 14},
        "stroke_color": {"type": "string", "pattern": "^#[A-Fa-f0-9]{6}$"}, "background_color": {"type": "string", "pattern": "^(transparent|#[A-Fa-f0-9]{6})$"},
        "stroke_width": {"type": "number", "minimum": 0.5, "maximum": 8}, "roughness": {"type": "number", "minimum": 0, "maximum": 2},
        "points": {"type": "array", "minItems": 2, "items": {"type": "array", "prefixItems": [{"type": "number"}, {"type": "number"}], "items": false}},
        "group_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "start_element_id": {"type": "string", "minLength": 1}, "end_element_id": {"type": "string", "minLength": 1},
        "mapping_index": {"type": "integer", "minimum": 0}, "source_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "assertion": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {"if": {"properties": {"type": {"const": "text"}}}, "then": {"required": ["text", "font_size"]}},
        {"if": {"properties": {"type": {"enum": ["line", "arrow"]}}}, "then": {"required": ["points"]}},
        {"if": {"properties": {"type": {"const": "arrow"}}}, "then": {"required": ["start_element_id", "end_element_id"]}}
      ]
    },
    "page": {
      "type": "object", "additionalProperties": false,
      "required": ["page_id", "page_kind", "display_order", "grammar", "composition_intent", "selected_candidate_id", "semantic_guardrails", "elements"],
      "properties": {
        "page_id": {"type": "string", "minLength": 1}, "page_kind": {"enum": ["cover", "overview", "deep_dive"]},
        "display_order": {"type": "integer", "minimum": 0}, "grammar": {"type": "string", "minLength": 1},
        "composition_intent": {"$ref": "#/$defs/intent"}, "selected_candidate_id": {"type": ["string", "null"]},
        "semantic_guardrails": {"type": "array", "items": {"type": "string"}}, "elements": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/element"}},
        "brand_asset": {"type": "object", "additionalProperties": false, "required": ["relative_path", "sha256", "x", "y", "width", "height"], "properties": {
          "relative_path": {"type": "string", "pattern": "\\.(png|jpe?g)$"}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "x": {"type": "number", "minimum": 0}, "y": {"type": "number", "minimum": 0}, "width": {"type": "number", "exclusiveMinimum": 0}, "height": {"type": "number", "exclusiveMinimum": 0}
        }}
      }
    }
  }
}
