{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ContentSplitGate",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "status", "episode_content_inventory_sha256", "content_split_sha256", "content_split_coverage_sha256", "content_split_document_sha256", "checks", "human_review_required"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "kind": {"const": "content_split_gate"},
    "status": {"enum": ["pass", "needs_human_review", "fail"]},
    "episode_content_inventory_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "content_split_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "content_split_coverage_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "content_split_document_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "checks": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["name", "status", "details"], "properties": {"name": {"type": "string", "minLength": 1}, "status": {"enum": ["pass", "needs_human_review", "fail"]}, "details": {"type": "object"}}}},
    "human_review_required": {"type": "boolean"},
    "human_review": {"type": "object"}
  }
}
