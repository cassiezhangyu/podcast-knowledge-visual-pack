{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EditorialPlan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "status", "editorial_plan_id", "editorial_cache_key", "pipeline_version", "input", "execution", "policy", "package", "coverage_matrix_sha256", "review_status", "created_at"],
  "properties": {
    "schema_version": {"const": "1.0"}, "kind": {"const": "editorial_plan"}, "status": {"enum": ["partial", "completed"]},
    "editorial_plan_id": {"type": "string", "pattern": "^edp_[a-z0-9_]+$"}, "editorial_cache_key": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "pipeline_version": {"type": "string", "minLength": 1},
    "input": {"type": "object", "additionalProperties": false, "required": ["knowledge_graph_sha256", "knowledge_gate_sha256", "knowledge_base_sha256", "audio_sha256", "episode_metadata_sha256"], "properties": {"knowledge_graph_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "knowledge_gate_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "knowledge_base_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "audio_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "episode_metadata_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}},
    "execution": {"type": "object", "additionalProperties": false, "required": ["kind", "model_id", "runtime_id", "identity_status"], "properties": {"kind": {"const": "current_skill_execution_model"}, "model_id": {"type": ["string", "null"]}, "runtime_id": {"type": ["string", "null"]}, "identity_status": {"enum": ["reported_by_host", "not_exposed_by_host"]}}},
    "policy": {"type": "object", "additionalProperties": false, "required": ["focus", "audience", "max_deep_dive_pages", "output_language", "selection_policy_version"], "properties": {"focus": {"type": ["string", "null"]}, "audience": {"type": ["string", "null"]}, "max_deep_dive_pages": {"type": ["integer", "null"], "minimum": 1}, "output_language": {"type": "string", "minLength": 1}, "selection_policy_version": {"type": "string", "minLength": 1}}},
    "package": {"type": "object", "additionalProperties": false, "required": ["package_thesis", "cover", "overview", "deep_dives"], "properties": {"package_thesis": {"$ref": "#/$defs/derived_statement"}, "cover": {"$ref": "#/$defs/cover"}, "overview": {"$ref": "#/$defs/overview"}, "overview_continuations": {"type": "array", "items": {"$ref": "#/$defs/overview_continuation"}}, "deep_dives": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/deep_dive"}}}},
    "coverage_matrix_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "review_status": {"enum": ["needs_human_review", "accepted", "revise"]}, "created_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "overview_continuation": {"type": "object", "additionalProperties": false, "required": ["page_id", "display_order", "role", "page_question", "takeaway", "mental_model_statement", "model_components", "model_connectors", "deep_dive_map", "derived_from_ids", "evidence_anchor_ids", "information_budget"], "properties": {"page_id": {"type": "string", "pattern": "^edp_overview_"}, "display_order": {"type": "integer", "minimum": 2}, "role": {"const": "whole_picture"}, "page_question": {"type": "string", "minLength": 1}, "takeaway": {"type": "string", "minLength": 1}, "mental_model_statement": {"type": "string", "minLength": 1}, "model_components": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/model_component"}}, "model_connectors": {"type": "array", "items": {"$ref": "#/$defs/model_connector"}}, "deep_dive_map": {"type": "array", "items": {"$ref": "#/$defs/deep_dive_map_entry"}}, "derived_from_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "evidence_anchor_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^ea_"}}, "information_budget": {"$ref": "#/$defs/information_budget"}}},
    "derived_statement": {"type": "object", "additionalProperties": false, "required": ["statement", "epistemic_status", "derived_from_ids", "evidence_anchor_ids", "confidence", "uncertainty"], "properties": {"statement": {"type": "string", "minLength": 1}, "epistemic_status": {"const": "episode_synthesis"}, "derived_from_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "evidence_anchor_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^ea_"}}, "confidence": {"enum": ["high", "medium", "low"]}, "uncertainty": {"type": "string"}}},
    "cover": {"type": "object", "additionalProperties": false, "required": ["page_id", "display_order", "role", "title", "subtitle", "derived_from_ids", "evidence_anchor_ids", "epistemic_status", "confidence", "uncertainty"], "properties": {"page_id": {"type": "string", "pattern": "^edp_cover_"}, "display_order": {"const": 0}, "role": {"const": "package_entry"}, "title": {"type": "string", "minLength": 1}, "subtitle": {"type": ["string", "null"]}, "derived_from_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "evidence_anchor_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^ea_"}}, "epistemic_status": {"const": "episode_synthesis"}, "confidence": {"enum": ["high", "medium", "low"]}, "uncertainty": {"type": "string"}}},
    "placement": {"type": "object", "additionalProperties": false, "required": ["page_id", "coverage", "reason"], "properties": {"page_id": {"type": "string", "pattern": "^edp_"}, "coverage": {"enum": ["mention", "explain", "evidence", "boundary"]}, "reason": {"type": "string", "minLength": 1}}},
    "overview": {"type": "object", "additionalProperties": false, "required": ["page_id", "display_order", "role", "page_question", "takeaway", "mental_model_statement", "model_components", "model_connectors", "deep_dive_map", "derived_from_ids", "evidence_anchor_ids", "information_budget"], "properties": {"page_id": {"type": "string", "pattern": "^edp_overview_"}, "display_order": {"const": 1}, "role": {"const": "whole_picture"}, "page_question": {"type": "string", "minLength": 1}, "takeaway": {"type": "string", "minLength": 1}, "mental_model_statement": {"type": "string", "minLength": 1}, "model_components": {"type": "array", "minItems": 3, "items": {"$ref": "#/$defs/model_component"}}, "model_connectors": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/model_connector"}}, "deep_dive_map": {"type": "array", "items": {"$ref": "#/$defs/deep_dive_map_entry"}}, "derived_from_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "evidence_anchor_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^ea_"}}, "information_budget": {"$ref": "#/$defs/information_budget"}}},
    "model_component": {"type": "object", "additionalProperties": false, "required": ["id", "role", "knowledge_ids", "evidence_anchor_ids", "statement"], "properties": {"id": {"type": "string", "pattern": "^omc_"}, "role": {"enum": ["question", "signal", "process", "judgment", "practice", "boundary", "new_context", "conclusion"]}, "knowledge_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "evidence_anchor_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^ea_"}}, "statement": {"type": "string", "minLength": 1}}},
    "model_connector": {"type": "object", "additionalProperties": false, "required": ["from_component_id", "to_component_id", "kind", "reason"], "properties": {"from_component_id": {"type": "string", "pattern": "^omc_"}, "to_component_id": {"type": "string", "pattern": "^omc_"}, "kind": {"enum": ["relationship", "parallel_context"]}, "relationship_id": {"type": ["string", "null"], "pattern": "^rel_"}, "reason": {"type": "string", "minLength": 1}}},
    "deep_dive_map_entry": {"type": "object", "additionalProperties": false, "required": ["deep_dive_page_id", "component_ids", "reason"], "properties": {"deep_dive_page_id": {"type": "string", "pattern": "^edp_dd_"}, "component_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^omc_"}}, "reason": {"type": "string", "minLength": 1}}},
    "deep_dive": {"type": "object", "additionalProperties": false, "required": ["page_id", "display_order", "role", "page_question", "takeaway", "primary_knowledge_ids", "primary_relationship_ids", "supporting_knowledge_ids", "evidence_anchor_ids", "coverage", "argument_preconditions", "order_rationale", "information_budget"], "properties": {"page_id": {"type": "string", "pattern": "^edp_dd_"}, "supersedes_page_id": {"type": ["string", "null"], "pattern": "^edp_dd_"}, "display_order": {"type": "integer", "minimum": 2}, "role": {"enum": ["opening", "build", "deepen", "apply", "boundary", "closing"]}, "page_question": {"type": "string", "minLength": 1}, "takeaway": {"type": "string", "minLength": 1}, "primary_knowledge_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "primary_relationship_ids": {"type": "array", "items": {"type": "string", "pattern": "^rel_"}}, "supporting_knowledge_ids": {"type": "array", "items": {"type": "string"}}, "evidence_anchor_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^ea_"}}, "coverage": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/placement"}}, "argument_preconditions": {"type": "array", "items": {"type": "string", "pattern": "^edp_"}}, "order_rationale": {"type": "string", "minLength": 1}, "information_budget": {"$ref": "#/$defs/information_budget"}}},
    "information_budget": {"type": "object", "additionalProperties": false, "required": ["primary_proposition_max", "max_independent_ideas", "required_elements"], "properties": {"primary_proposition_max": {"type": "integer", "minimum": 1}, "max_independent_ideas": {"type": "integer", "minimum": 1}, "required_elements": {"type": "array", "minItems": 1, "items": {"enum": ["claim", "mechanism", "example", "boundary", "counterpoint", "relationship", "application", "question"]}}}}
  }
}
