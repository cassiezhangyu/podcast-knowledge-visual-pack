{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IndependentVisualReview", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "kind", "status", "render_manifest_sha256", "reviewer_context", "reviewer_context_id", "pages", "reviewed_at"],
  "properties": {
    "schema_version": {"const": "1.0"}, "kind": {"const": "independent_visual_review"}, "status": {"const": "completed"},
    "render_manifest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "reviewer_context": {"const": "isolated_read_only"},
    "reviewer_context_id": {"type": "string", "minLength": 2},
    "pages": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["page_id", "png_sha256", "review_packet_sha256", "verdict", "findings"], "properties": {"page_id": {"type": "string"}, "png_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "review_packet_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "verdict": {"enum": ["TARGET", "REJECT-A", "REJECT-B"]}, "findings": {"type": "array", "items": {"type": "string"}}}}},
    "reviewed_at": {"type": "string", "format": "date-time"}
  }
}
