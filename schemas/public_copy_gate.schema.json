{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PublicCopyGate", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "kind", "status", "public_copy_record_sha256", "checks"],
  "properties": {
    "schema_version": {"const": "1.0"}, "kind": {"const": "public_copy_gate"}, "status": {"enum": ["pass", "fail"]},
    "public_copy_record_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "checks": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["name", "status", "details"], "properties": {"name": {"type": "string"}, "status": {"enum": ["pass", "fail"]}, "details": {"type": "object"}}}}
  }
}
