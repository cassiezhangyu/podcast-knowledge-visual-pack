l, "locked": false, "updated": 1, "seed": 278, "text": "土壤：知识体系", "fontSize": 32, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "土壤：知识体系", "autoResize": false, "lineHeight": 1.25, "customData": {"typography_role": "section_entry"}}, {"id": "A_t_0279", "type": "text", "x": 138.8, "y": 1070.0, "width": 237.44, "height": 40.0, "angle": 0, "strokeColor": "#235D9F", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "roundness": null, "version": 1, "versionNonce": 278, "isDeleted": false, "boundElements": null, "link": null, "locked": false, "updated": 1, "seed": 278, "text": "土壤：知识体系", "fontSize": 32, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "土壤：知识体系", "autoResize": false, "lineHeight": 1.25, "customData": {"typography_role": "section_entry", "dup": true}}, {"id": "A_t_0280", "type": "text", "x": 399.44, "y": 1076.0, "width": 524.16, "height": 30.0, "angle": 0, "strokeColor": "#273348", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "roundness": null, "version": 1, "versionNonce": 280, "isDeleted": false, "boundElements": null, "link": null, "locked": false, "updated": 1, "seed": 280, "text": "（三步都靠它才能成立，但它本身不是第四步）", "fontSize": 24, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "（三步都靠它才能成立，但它本身不是第四步）", "autoResize": false, "lineHeight": 1.25, "customData": {"typography_role": "body"}}, {"id": "A_t_0281", "type": "text", "x": 138, "y": 1114.0, "width": 923.52, "height": 30.0, "angle": 0, "strokeColor": "#273348", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "roundness": null, "version": 1, "versionNonce": 281, "isDeleted": false, "boundElements": null, "link": null, "locked": false, "updated": 1, "seed": 281, "text": "和旧知连上才活；知识要自己长成网，不是先搭框架再往里填；遇事能随时调出来。", "fontSize": 24, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "和旧知连上才活；知识要自己长成网，不是先搭框架再往里填；遇事能随时调出来。", "autoResize": false, "lineHeight": 1.25, "customData": {"typography_role": "body"}}, {"id": "A_line_0282", "type": "line", "x": 1090, "y": 994.0, "width": 300.79999999999995, "height": 178.0, "angle": 0, "strokeColor": "#235D9F", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2.6, "strokeStyle": "solid", "roughness": 0.9, "opacity": 100, "groupIds": [], "roundness": {"type": 2}, "version": 1, "versionNonce": 282, "isDeleted": false, "boundElements": null, "link": null, "locked": false, "updated": 1, "seed": 5363, "customData": {"stroke_role": "curve"}, "points": [[0, 0.0], [14, 79.0], [-4, 176.0], [-286.79999999999995, 178.0]], "lastCommittedPoint": null, "startBinding": null, "endBinding": null, "startArrowhead": null, "endArrowhead": null}, {"id": "A_arrow_0283", "type": "arrow", "x": 396.79999999999995, "y": 1172.0, "width": 298.79999999999995, "height": 324.0, "angle": 0, "strokeColor": "#235D9F", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2.6, "strokeStyle": "solid", "roughness": 0.9, "opacity": 100, "groupIds": [], "roundness": {"type": 2}, "version": 1, "versionNonce": 283, "isDeleted": false, "boundElements": null, "link": null, "locked": false, "updated": 1, "seed": 5382, "customData": {"stroke_role": "curve"}, "points": [[0.0, 0.0], [-278.79999999999995, -2.0], [-298.79999999999995, -99.0], [-292.79999999999995, -264.0], [-246.79999999999995, -324.0]], "lastCommittedPoint": null, "startBinding": null, "endBinding": null, "startArrowhead": null, "endArrowhead": "arrow"}, {"id": "A_t_0284", "type": "text", "x": 412.79999999999995, "y": 1156.0, "width": 374.40000000000003, "height": 30.0, "angle": 0, "strokeColor": "#