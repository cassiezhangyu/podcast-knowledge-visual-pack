sparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "roundness": null, "version": 1, "versionNonce": 294, "isDeleted": false, "boundElements": null, "link": null, "locked": false, "updated": 1, "seed": 294, "text": "人生体验", "fontSize": 24, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "人生体验", "autoResize": false, "lineHeight": 1.25, "customData": {"typography_role": "body"}}, {"id": "A_t_0295", "type": "text", "x": 586.48, "y": 1251.0, "width": 449.28000000000003, "height": 30.0, "angle": 0, "strokeColor": "#273348", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "roundness": null, "version": 1, "versionNonce": 295, "isDeleted": false, "boundElements": null, "link": null, "locked": false, "updated": 1, "seed": 295, "text": "第三层一定要靠破·立·行慢慢长出来。", "fontSize": 24, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "第三层一定要靠破·立·行慢慢长出来。", "autoResize": false, "lineHeight": 1.25, "customData": {"typography_role": "body"}}, {"id": "A_ellipse_0296", "type": "ellipse", "x": 80, "y": 1310.0, "width": 12, "height": 12, "angle": 0, "strokeColor": "#A95728", "backgroundColor": "#A95728", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1.6, "opacity": 100, "groupIds": [], "roundness": null, "version": 1, "versionNonce": 296, "isDeleted": false, "boundElements": null, "link": null, "locked": false, "updated": 1, "seed": 5629, "customData": {"stroke_role": "accent_detail"}}, {"id": "A_t_0297", "type": "text", "x": 100, "y": 1302.0, "width": 973.44, "height": 30.0, "angle": 0, "strokeColor": "#273348", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "roundness": null, "version": 1, "versionNonce": 297, "isDeleted": false, "boundElements": null, "link": null, "locked": false, "updated": 1, "seed": 297, "text": "个人方法，无标准答案；每次最多记一到三个点；旧想法破了，新想法过一阵才立起来。", "fontSize": 24, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "个人方法，无标准答案；每次最多记一到三个点；旧想法破了，新想法过一阵才立起来。", "autoResize": false, "lineHeight": 1.25, "customData": {"typography_role": "body"}}, {"id": "A_t_0298", "type": "text", "x": 80, "y": 1342.0, "width": 648.96, "height": 30.0, "angle": 0, "strokeColor": "#1A4677", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "roundness": null, "version": 1, "versionNonce": 298, "isDeleted": false, "boundElements": null, "link": null, "locked": false, "updated": 1, "seed": 298, "text": "记得越少越好：从触动你的地方出发，连上你已有的经验。", "fontSize": 24, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "记得越少越好：从触动你的地方出发，连上你已有的经验。", "autoResize": false, "lineHeight": 1.25, "customData": {"typography_role": "body"}}, {"id": "A_rectangle_0299", "type": "rectangle", "x": 80, "y": 1388.0, "width": 1040, "height": 88, "angle": 0, "strokeColor": "#A7BED9", "backgroundColor": "#EDF2F7", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1.1, "opacity": 100, "groupIds": [], "roundness": null, "version": 1, "versionNonce": 299, "isDeleted": false, "boundElements": null, "link": null, "locked": false, "updated": 1, "seed": 5686, "customData": {"stroke_role": "frame"}}, {"id": "A_t_0300", "type": "text", "x": 98, "y": 1400.0, "width": 96.8, "height": 27.5, "angle": 0, "strokeColor": "#1A4677", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "roundness": null, "version": 1, "versionNonce": 300, "isDeleted": false, "boundElements": null, "link": null, "locked": false, "updated": 1, "seed": 3