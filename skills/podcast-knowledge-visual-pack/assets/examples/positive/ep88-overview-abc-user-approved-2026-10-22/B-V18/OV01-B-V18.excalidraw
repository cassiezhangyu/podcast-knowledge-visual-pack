roupIds": [], "roundness": null, "version": 1, "versionNonce": 273, "isDeleted": false, "boundElements": null, "link": null, "locked": false, "updated": 1, "seed": 273, "text": "底层的思维方式", "fontSize": 24, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "底层的思维方式", "autoResize": false, "lineHeight": 1.25, "customData": {"typography_role": "body"}}, {"id": "B_rectangle_0274", "type": "rectangle", "x": 434.64, "y": 1252.0, "width": 127.84, "height": 38, "angle": 0, "strokeColor": "#235D9F", "backgroundColor": "#EDF2F7", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1.1, "opacity": 100, "groupIds": [], "roundness": {"type": 3}, "version": 1, "versionNonce": 274, "isDeleted": false, "boundElements": null, "link": null, "locked": false, "updated": 1, "seed": 5211, "customData": {"stroke_role": "frame"}}, {"id": "B_t_0275", "type": "text", "x": 448.64, "y": 1257.0, "width": 105.6, "height": 30.0, "angle": 0, "strokeColor": "#273348", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "roundness": null, "version": 1, "versionNonce": 275, "isDeleted": false, "boundElements": null, "link": null, "locked": false, "updated": 1, "seed": 275, "text": "人生体验", "fontSize": 24, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "人生体验", "autoResize": false, "lineHeight": 1.25, "customData": {"typography_role": "body"}}, {"id": "B_t_0276", "type": "text", "x": 586.48, "y": 1257.0, "width": 449.28000000000003, "height": 30.0, "angle": 0, "strokeColor": "#273348", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "roundness": null, "version": 1, "versionNonce": 276, "isDeleted": false, "boundElements": null, "link": null, "locked": false, "updated": 1, "seed": 276, "text": "第三层一定要靠破·立·行慢慢长出来。", "fontSize": 24, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "第三层一定要靠破·立·行慢慢长出来。", "autoResize": false, "lineHeight": 1.25, "customData": {"typography_role": "body"}}, {"id": "B_ellipse_0277", "type": "ellipse", "x": 80, "y": 1314.0, "width": 12, "height": 12, "angle": 0, "strokeColor": "#A95728", "backgroundColor": "#A95728", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1.6, "opacity": 100, "groupIds": [], "roundness": null, "version": 1, "versionNonce": 277, "isDeleted": false, "boundElements": null, "link": null, "locked": false, "updated": 1, "seed": 5268, "customData": {"stroke_role": "accent_detail"}}, {"id": "B_t_0278", "type": "text", "x": 100, "y": 1306.0, "width": 973.44, "height": 30.0, "angle": 0, "strokeColor": "#273348", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "roundness": null, "version": 1, "versionNonce": 278, "isDeleted": false, "boundElements": null, "link": null, "locked": false, "updated": 1, "seed": 278, "text": "个人方法，无标准答案；每次最多记一到三个点；旧想法破了，新想法过一阵才立起来。", "fontSize": 24, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "个人方法，无标准答案；每次最多记一到三个点；旧想法破了，新想法过一阵才立起来。", "autoResize": false, "lineHeight": 1.25, "customData": {"typography_role": "body"}}, {"id": "B_t_0279", "type": "text", "x": 80, "y": 1344.0, "width": 648.96, "height": 30.0, "angle": 0, "strokeColor": "#1A4677", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "roundness": null, "version": 1, "versionNonce": 279, "isDeleted": false, "boundElements": null, "link": null, "locked": false, "updated": 1, "seed": 279, "text": "记得越少越好：从触动你的地方出发，连上你已有的经验。", "fontSize": 24, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "记得越少越好：从触动你的地方出发，连上你已有的经验。", "autoResize": false, "lineHeight": 1.25, "customData": {"typography_role": "body"}}, {"id": "B_rectangle_0280", "type": "rectangle", "x": 80, "y": 1388.0, "width": 1040, "height": 88, "angle": 0, "strokeColor": "#A7BED9", "backgroundColor": "#EDF2F7", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1.1, "opacity": 100, "groupIds": [], "roundness": null, "version": 1, "versionNonce": 280, "isDeleted": false, "boundElements": null, "link": null, "locked": false, "updated": 1, "seed": 5325, "customData": {"stroke_role": "frame"}}, {"id": "B_t_0281", "type": "text", "x": 98, "y": 1400.0, "width": 96.8, "height": 27.5, "angle": 0, "strokeColor": "#1A4677", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "roundness": null, "version": 1, "versionNonce": 281, "isDeleted": false, "boundElements": null, "link": null, "locked": false, "updated": 1, "seed": 281, "text": "本页提纲", "fontSize": 22, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "本页提纲", "autoResize": false, "lineHeight": 1.25, "customData": {"typography_role": "annotation", "text_function": "navigation"}}, {"id": "B_ellipse_0282", "type": "ellipse", "x": 205.52, "y": 1399.0, "width": 30, "height": 30, "angle": 0, "strokeColor": "#235D9F", "backgroundColor": "#235D9F", "fillStyle": "solid", "strokeWidth": 2.4, "strokeStyle": "solid", "roughness": 1.4, "opacity": 100, "groupIds": [], "roundness": null, "version": 1, "versionNonce": 282, "isDeleted": false, "boundElements": null, "link": null, "locked": false, "updated": 1, "seed": 5363, "customData": {"stroke_role": "object_simple"}}, {"id": "B_t_0283", "type": "text", "x": 214.1582875, "y": 1400.0, "width": 21.12, "height": 27.5, "angle": 0, "strokeColor": "#FFFFFF", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth