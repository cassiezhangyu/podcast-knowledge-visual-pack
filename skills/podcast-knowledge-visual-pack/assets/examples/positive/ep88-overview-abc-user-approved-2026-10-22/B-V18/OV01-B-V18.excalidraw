 false, "updated": 1, "seed": 263, "text": "消化成自己的之后，就会去做；\n做得出来才算学会。", "fontSize": 24, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "消化成自己的之后，就会去做；\n做得出来才算学会。", "autoResize": false, "lineHeight": 1.25, "customData": {"typography_role": "body"}}, {"id": "B_line_0264", "type": "line", "x": 680, "y": 1110.0, "width": 1, "height": 24.0, "angle": 0, "strokeColor": "#9AA1AC", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1.8, "strokeStyle": "solid", "roughness": 1.1, "opacity": 100, "groupIds": [], "roundness": null, "version": 1, "versionNonce": 264, "isDeleted": false, "boundElements": null, "link": null, "locked": false, "updated": 1, "seed": 5021, "customData": {"stroke_role": "rule"}, "points": [[0, 0.0], [0, 24.0]], "lastCommittedPoint": null, "startBinding": null, "endBinding": null, "startArrowhead": null, "endArrowhead": null}, {"id": "B_t_0265", "type": "text", "x": 692, "y": 1106.0, "width": 399.36, "height": 30.0, "angle": 0, "strokeColor": "#273348", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "roundness": null, "version": 1, "versionNonce": 265, "isDeleted": false, "boundElements": null, "link": null, "locked": false, "updated": 1, "seed": 265, "text": "睡眠：到点照着仪式做，不用再想。", "fontSize": 24, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "睡眠：到点照着仪式做，不用再想。", "autoResize": false, "lineHeight": 1.25, "customData": {"typography_role": "body"}}, {"id": "B_ellipse_0266", "type": "ellipse", "x": 80, "y": 1210.0, "width": 32, "height": 32, "angle": 0, "strokeColor": "#235D9F", "backgroundColor": "#235D9F", "fillStyle": "solid", "strokeWidth": 2.4, "strokeStyle": "solid", "roughness": 1.4, "opacity": 100, "groupIds": [], "roundness": null, "version": 1, "versionNonce": 266, "isDeleted": false, "boundElements": null, "link": null, "locked": f