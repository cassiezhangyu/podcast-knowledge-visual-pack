": 22, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "5", "autoResize": false, "lineHeight": 1.25, "customData": {"typography_role": "annotation"}}, {"id": "B_t_0220", "type": "text", "x": 144, "y": 1030.0, "width": 237.44, "height": 40.0, "angle": 0, "strokeColor": "#235D9F", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "roundness": null, "version": 1, "versionNonce": 220, "isDeleted": false, "boundElements": null, "link": null, "locked": false, "updated": 1, "seed": 220, "text": "土壤：知识体系", "fontSize": 32, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "土壤：知识体系", "autoResize": false, "lineHeight": 1.25, "customData": {"typography_role": "section_entry"}}, {"id": "B_t_0221", "type": "text", "x": 144.8, "y": 1030.0, "width": 237.44, "height": 40.0, "angle": 0, "strokeColor": "#235D9F", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "roundness": null, "version": 1, "versionNonce": 220, "isDeleted": false, "boundElements": null, "link": null, "locked": false, "updated": 1, "seed": 220, "text": "土壤：知识体系", "fontSize": 32, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "土壤：知识体系", "autoResize": false, "lineHeight": 1.25, "customData": {"typography_role": "section_entry", "dup": true}}, {"id": "B_t_0222", "type": "text", "x": 102, "y": 1072.0, "width": 499.20000000000005, "height": 60.0, "angle": 0, "strokeColor": "#273348", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "roundness": null, "version": 1, "versionNonce": 222, "isDeleted": false, "boundElements": null, "link": null, "locked": false, "updated": 1, "seed": 222, "text": "和旧知连上才活；知识要自己长成网，不是先\n搭框架再往里填；遇事能随时调出来。", "fontSize": 24, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "和旧知连上才活；知识要自己长成网，不是先\n搭框架再往里填；遇事能随时调出来。", "autoResize": false, "lineHeight": 1.25, "customData": {"typography_role": "body"}}, {"id": "B_t_0223", "type": "text", "x": 102, "y": 1134.0, "width": 474.24, "height": 30.0, "angle": 0, "strokeColor": "#1A4677", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "roundness": null, "version": 1, "versionNonce": 223, "isDeleted": false, "boundElements": null, "link": null, "locked": false, "updated": 1, "seed": 223, "text": "三步都靠它才能成立，但它本身不是第四步", "fontSize": 24, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "三步都靠它才能成立，但它本身不是第四步", "autoResize": false, "lineHeight": 1.25, "customData": {"typography_role": "body"}}, {"id": "B_arrow_0224", "type": "arrow", "x": 614, "y": 594.0, "width": 276, "height": 182.0, "angle": 0, "strokeColor": "#235D9F", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2.6, "strokeStyle": "solid", "roughness": 0.9, "opacity": 100, "groupIds": [], "roundness": {"type": 2}, "version": 1, "versionNonce": 224, "isDeleted": false, "boundElements": null, "link": null, "locked": false, "updated": 1, "seed": 4261, "customData": {"stroke_role": "curve"}, "points": [[0, 0.0], [16, -102.0], [-44, -182.0], [-230, -176.0], [-260, -156.0]], "lastCommittedPoint": null, "startBinding": null, "endBinding": null, "startArrowhead": null, "endArrowhead": "arrow"}, {"id": "B_t_0225", "type": "text", "x": 406, "y": 508.0, "width": 129.6, "height": 90.0, "angle": 0, "strokeColor": "#1A4677", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "roundness": null, "version": 1, "versionNonce": 225, "isDeleted": false, "boundElements": null, "link": null, "locked": false, "updated": 1, "seed": 225, "text": "行动又带回\n新的触动，\n开始下一轮", "fontSize": 24, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "行动又带回\n新的触动，\n开始下一轮", "autoResize": false, "lineHeight": 1.25, "customData": {"typography_role": "body"}}, {"id": "B_line_0226", "type": "line", "x": 662, "y": 340.0, "width": 1, "height": 840.0, "angle": 0, "strokeColor": "#C9CED5", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1.8, "strokeStyle": "solid", "roughness": 1.1, "opacity": 100, "groupIds": [], "roundness": null, "version": 1, "versionNonce": 226, "isDeleted": false, "boundElements": null, "link": null, "locked": false, "updated": 1, "seed": 4299, "customData": {"stroke_role": "rule"}, "points": [[0, 0.0], [0, 840.0]], "lastCommittedPoint": null, "startBinding": null, "endBinding": null, "startArrowhead": null, "endArrowhead": null}, {"id": "B_ellipse_0227", "type": "ellipse", "x": 680, "y": 344.0, "width": 32, "height": 32, "angle": 0, "strokeColor": "#235D9F", "backgroundColor": "#235D9F", "fillStyle": "solid", "strokeWidth": 2.4, "strokeStyle": "solid", "roughness": 1.4, "opacity": 100, "groupIds": [], "roundness": null, "version": 1, "versionNonce": 227, "isDeleted": false, "boundElements": null, "link": null, "locked": false, "updated": 1, "seed": 4318, "customData": {"stroke_role": "object_simple"}}, {"id": "B_t_0228", "type": "text", "x": 689.6382875, "y": 346.25, "width": 21.12, "height": 27.5, "angle": 0, "strokeColor": "#FFFFFF", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "roundness": null, "version": 1, "versionNonce": 228, "isDeleted": false, "boundElements": null, "link": null, "locked": false, "updated": 1, "seed": 228, "text": "1", "fontSize": 22, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "o