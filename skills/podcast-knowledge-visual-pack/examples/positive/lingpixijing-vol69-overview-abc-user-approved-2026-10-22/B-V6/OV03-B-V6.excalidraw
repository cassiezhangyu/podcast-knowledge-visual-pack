, "link": null, "locked": false, "updated": 1, "seed": 3577, "customData": {"stroke_role": "detail"}, "points": [[0.0, 0.0], [4.0, 0.0]], "lastCommittedPoint": null, "startBinding": null, "endBinding": null, "startArrowhead": null, "endArrowhead": null}, {"id": "B_arrow_0189", "type": "arrow", "x": 330, "y": 519, "width": 38, "height": 1, "angle": 0, "strokeColor": "#9AA1AC", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2.2, "strokeStyle": "solid", "roughness": 0.8, "opacity": 100, "groupIds": [], "roundness": null, "version": 1, "versionNonce": 189, "isDeleted": false, "boundElements": null, "link": null, "locked": false, "updated": 1, "seed": 3596, "customData": {"stroke_role": "connector"}, "points": [[0, 0], [38, 0]], "lastCommittedPoint": null, "startBinding": null, "endBinding": null, "startArrowhead": null, "endArrowhead": "arrow"}, {"id": "B_t_0190", "type": "text", "x": 92, "y": 542, "width": 299.52, "height": 60.0, "angle": 0, "strokeColor": "#273348", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "roundness": null, "version": 1, "versionNonce": 190, "isDeleted": false, "boundElements": null, "link": null, "locked": false, "updated": 1, "seed": 190, "text": "日子像流水线：按部就班，\n却好久没觉得有劲。", "fontSize": 24, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "日子像流水线：按部就班，\n却好久没觉得有劲。", "autoResize": false, "lineHeight": 1.25, "customData": {"typography_role": "body"}}, {"id": "B_t_0191", "type": "text", "x": 92, "y": 617.3166666666667, "width": 276, "height": 120.0, "angle": 0, "strokeColor": "#27534B", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "roundness": null, "version": 1, "versionNonce": 191, "isDeleted": false, "boundElements": null, "link": null, "locked": false, "updated": 1, "seed": 191, "text": "被充电、没负担、不是\n被迫：\n心里像被重新启动，\n暂时跳出日常节奏。", "fontSize": 24, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "被充电、没负担、不是\n被迫：\n心里像被重新启动，\n暂时跳出日常节奏。", "autoResize": false, "lineHeight": 1.25, "customData": {"typography_role": "body"}}, {"id": "B_ellipse_0192", "type": "ellipse", "x": 92, "y": 762.6333333333334, "width": 10, "height": 10, "angle": 0, "strokeColor": "#806477", "backgroundColor": "#806477", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1.6, "opacity": 100, "groupIds": [], "roundness": null, "version": 1, "versionNonce": 192, "isDeleted": false, "boundElements": null, "link": null, "locked": false, "updated": 1, "seed": 3653, "customData": {"stroke_role": "accent_detail"}}, {"id": "B_t_0193", "type": "text", "x": 112, "y": 752.6333333333334, "width": 256, "height": 60.0, "angle": 0, "strokeColor": "#273348", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "roundness": null, "version": 1, "versionNonce": 193, "isDeleted": false, "boundElements": null, "link": null, "locked": false, "updated": 1, "seed": 193, "text": "同一个纽约早高峰：\n活人感因人而异", "fontSize": 24, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "同一个纽约早高峰：\n活人感因人而异", "autoResize": false, "lineHeight": 1.25, "customData": {"typography_role": "body"}}, {"id": "B_rectangle_0194", "type": "rectangle", "x": 92, "y": 822.6333333333334, "width": 40, "height": 30, "angle": 0, "strokeColor": "#27534B", "backgroundColor": "#346F64", "fillStyle": "solid", "strokeWidth": 2.4, "strokeStyle": "solid", "roughness": 1.4, "opacity": 100, "groupIds": [], "roundness": {"type": 3}, "version": 1, "versionNonce": 194, "isDeleted": false, "boundElements": null, "link": null, "locked": false, "updated": 1, "seed": 3691, "customData": {"stroke_role": "object_simple"}}, {"id": "B_rectangle_0