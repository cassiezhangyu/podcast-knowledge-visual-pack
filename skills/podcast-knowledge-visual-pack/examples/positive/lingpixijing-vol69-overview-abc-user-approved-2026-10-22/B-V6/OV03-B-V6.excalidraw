ull, "link": null, "locked": false, "updated": 1, "seed": 4451, "customData": {"stroke_role": "object_simple"}}, {"id": "B_t_0235", "type": "text", "x": 594.16, "y": 1271.99, "width": 105.6, "height": 30.0, "angle": 0, "strokeColor": "#27534B", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "roundness": null, "version": 1, "versionNonce": 235, "isDeleted": false, "boundElements": null, "link": null, "locked": false, "updated": 1, "seed": 235, "text": "世界很大", "fontSize": 24, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "世界很大", "autoResize": false, "lineHeight": 1.25, "customData": {"typography_role": "body"}}, {"id": "B_t_0236", "type": "text", "x": 578.4799999999999, "y": 1320.6299999999999, "width": 105.6, "height": 30.0, "angle": 0, "strokeColor": "#273348", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "roundness": null, "version": 1, "versionNonce": 236, "isDeleted": false, "boundElements": null, "link": null, "locked": false, "updated": 1, "seed": 236, "text": "我的烦恼", "fontSize": 24, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "我的烦恼", "autoResize": false, "lineHeight": 1.25, "customData": {"typography_role": "body"}}, {"id": "B_t_0237", "type": "text", "x": 80, "y": 1291.95, "width": 444, "height": 30.0, "angle": 0, "strokeColor": "#273348", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "roundness": null, "version": 1, "versionNonce": 237, "isDeleted": false, "boundElements": null, "link": null, "locked": false, "updated": 1, "seed": 237, "text": "烟火气的 alive：日常里的热乎劲。", "fontSize": 24, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "烟火气的 alive：日常里的热乎劲。", "autoResize": false, "lineHeight": 1.25, "customData": {"typography_role": "body"}}, {"id": "B_t_0238", "type": "text", "x": 80, "y": 1325.95, "width": 444, "height": 60.0, "angle": 0, "strokeColor": "#273348", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "roundness": null, "version": 1, "versionNonce": 238, "isDeleted": false, "boundElements": null, "link": null, "locked": false, "updated": 1, "seed": 238, "text": "生命底层的唤醒：意识到世界很大，\n眼前的烦恼就小了（卫城、大海）。", "fontSize": 24, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "生命底层的唤醒：意识到世界很大，\n眼前的烦恼就小了（卫城、大海）。", "autoResize": false, "lineHeight": 1.25, "customData": {"typography_role": "body"}}, {"id": "B_ellipse_0239", "type": "ellipse", "x": 772, "y": 1250.95, "width": 30, "height": 30, "angle": 0, "strokeColor": "#346F64", "backgroundColor": "#346F64", "fillStyle": "solid", "strokeWidth": 2.4, "strokeStyle": "solid", "roughness": 1.4, "opacity": 100, "groupIds": [], "roundness": null, "version": 1, "versionNonce": 239, "isDeleted": false, "boundElements": null, "link": null, "locked": false, "updated": 1, "seed": 4546, "customData": {"stroke_role": "object_simple"}}, {"id": "B_t_0240", "type": "text", "x": 780.6382875, "y": 1252.2, "width": 21.12, "height": 27.5, "angle": 0, "strokeColor": "#FFFFFF", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "roundness": null, "version": 1, "versionNonce": 240, "isDeleted": false, "boundElements": null, "link": null, "locked": false, "updated": 1, "seed": 240, "text": "7", "fontSize": 22, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "7", "autoResize": false, "lineHeight": 1.25, "customData": {"typography_role": "annotation"}}, {"id": "B_t_02