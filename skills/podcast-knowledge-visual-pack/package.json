{
  "name": "podcast-knowledge-skill",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run build:preview",
    "build:preview": "esbuild scripts/src/excalidraw-preview-browser.ts --bundle --platform=browser --format=iife --outfile=dist/excalidraw-preview-browser.js && node scripts/stamp-render-build.mjs",
    "test": "vitest run --config development/build-tools/vitest.config.ts",
    "preintake": "npm run build",
    "intake": "node dist/cli.js",
    "content:gate": "npm run build && node dist/content-gates-cli.js",
    "knowledge:prepare": "npm run build && node dist/knowledge-cli.js",
    "knowledge:assemble": "npm run build && node dist/knowledge-assemble-cli.js",
    "knowledge:closeout": "npm run build && node dist/knowledge-closeout-cli.js",
    "editorial:assemble": "npm run build && node dist/editorial-assemble-cli.js",
    "editorial:closeout": "npm run build && node dist/editorial-closeout-cli.js",
    "visual:candidates": "npm run build && node dist/visual-candidates-cli.js",
    "visual:select": "npm run build && node dist/visual-select-cli.js",
    "construct": "tsc -p tsconfig.json && node dist/construction-cli.js",
    "construction:closeout": "npm run build && node dist/construction-closeout-cli.js",
    "render": "npm run build && node dist/render-cli.js",
    "render:preflight": "npm run build && node scripts/render-runtime-preflight.mjs",
    "render:checked": "node scripts/render-checked.mjs",
    "visual:review:prepare": "python3 scripts/prepare_independent_review.py",
    "visual:closeout": "npm run build && node dist/visual-closeout-cli.js",
    "render:manifest": "npm run build && node dist/render-manifest-cli.js",
    "author-check:init": "npm run build && node dist/author-check-init-cli.js",
    "preview:copies": "python3 scripts/make_preview_copies.py",
    "public-copy:check": "npm run build && node dist/public-copy-cli.js",
    "public-copy:bundle-check": "node scripts/check-companion-copy.mjs",
    "package": "npm run build && node dist/package-cli.js",
    "workflow:status": "npm run build && node dist/workflow-cli.js",
    "accepted-artwork:import": "tsc -p tsconfig.json && node dist/accepted-artwork-import-cli.js",
    "content:assemble": "npm run build && python3 scripts/assemble_content_package.py",
    "layout:budget": "python3 scripts/layout_budget.py",
    "layout:margins": "python3 scripts/audit_overlap_margins.py",
    "test:python": "python3 -m unittest discover -s development/tests -p '*.py'",
    "test:guards": "npm run build && node --test development/tests/closeout_guards.test.mjs",
    "render:scene:checked": "npm run build && node scripts/render-scene-checked.mjs",
    "preflight:bump": "python3 scripts/bump_preflight.py",
    "overrides:check": "python3 scripts/check_project_overrides.py",
    "overrides:scan": "python3 scripts/check_project_overrides.py --scan",
    "outline:regions": "python3 scripts/check_outline_body_alignment.py",
    "erratum:apply": "npm run build && node dist/erratum-cli.js",
    "visual:register-versions": "npm run build && node dist/delivery-versions-cli.js",
    "audit:dead-space": "python3 scripts/audit_dead_space.py",
    "round:diff": "python3 scripts/round_diff.py",
    "visual-quality:init": "npm run build && node dist/visual-quality-cli.js --action init",
    "visual-quality:check": "npm run build && node dist/visual-quality-cli.js --action check"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "^0.18.1",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "cheerio": "^1.1.2",
    "playwright": "^1.63.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=24"
  }
}
