{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ContentSplitCoverage",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "status", "episode_content_inventory_sha256", "content_split_sha256", "unit_dispositions", "detail_dispositions"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "kind": {"const": "content_split_coverage"},
    "status": {"enum": ["partial", "completed"]},
    "episode_content_inventory_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "content_split_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "unit_dispositions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "destination", "module_ids", "role", "rationale"],
        "properties": {
          "source_id": {"type": "string", "pattern": "^cu_"},
          "destination": {"enum": ["program_frame", "module", "program_synthesis", "excluded_with_reason"]},
          "module_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^mod_"}},
          "role": {"type": "string", "minLength": 1},
          "rationale": {"type": "string", "minLength": 1}
        }
      }
    },
    "detail_dispositions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "module_ids", "role", "rationale"],
        "properties": {
          "source_id": {"type": "string", "pattern": "^det_"},
          "module_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^mod_"}},
          "role": {"enum": ["program_frame", "claim", "mechanism", "evidence", "example", "boundary", "counterpoint", "context", "program_synthesis", "excluded_with_reason"]},
          "rationale": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
