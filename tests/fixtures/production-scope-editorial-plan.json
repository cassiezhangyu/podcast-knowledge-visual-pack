stemic_status": "episode_synthesis", "confidence": "medium", "uncertainty": "原标题保留完整；副标题是已批准编辑提炼。"}, "overview": {"page_id": "edp_overview_65cf16010bef6c2074f130e1", "display_order": 1, "role": "whole_picture", "page_question": "情绪到底是什么、怎么来的，我们能拿它怎么办？", "takeaway": "情绪是大脑对身体感受的预测，是被构建出来的，所以可以重新构建。", "mental_model_statement": "没听过节目的读者读完能说出：旧的“情绪指纹”观被推翻了；大脑靠预测运作（体验盲区、内感受、预测/误差、身体预算）；情绪就是对内感受的预测，所以由概念塑造、随情境变化、没有标准模板；日常可以用主播的五步重新构建情绪，长期预算失衡与身心健康相关；以及这些说法的边界。", "model_components": [{"id": "omc_1_1", "role": "question", "knowledge_ids": ["mech_det_16_01", "clm_det_16_02", "mech_det_16_03"], "evidence_anchor_ids": ["ea_16_01", "ea_16_02", "ea_16_03"], "statement": "整期问题：情绪到底是什么、怎么来的，我们能拿它怎么办？"}, {"id": "omc_1_2", "role": "judgment", "knowledge_ids": ["clm_det_02_01", "clm_det_02_03", "mech_det_03_03", "bnd_det_03_05", "mech_det_04_02", "clm_det_04_03", "mech_det_05_04", "mech_det_08_01", "clm_det_08_06", "bnd_det_09_04"], "evidence_anchor_ids": ["ea_02_01", "ea_02_03", "ea_03_03", "ea_03_05", "ea_04_02", "ea_04_03", "ea_05_04", "ea_08_01", "ea_08_06", "ea_09_04"], "statement": "旧观念被推翻：情绪不是“刺激→固定表情/脑区”的指纹反应——情境实验与4个元分析都找不到指纹，人们其实靠上下文判断情绪"}, {"id": "omc_1_3", "role": "process", "knowledge_ids": ["mech_det_10_04", "clm_det_11_01", "mech_det_11_02", "clm_det_11_03", "mech_det_11_04", "mech_det_12_02", "clm_det_14_02", "mech_det_14_03", "mech_det_14_04", "mech_det_14_06", "mech_det_15_01", "mech_det_15_02"], "evidence_anchor_ids": ["ea_10_04", "ea_11_01", "ea_11_02", "ea_11_03", "ea_11_04", "ea_12_02", "ea_14_02", "ea_14_03", "ea_14_04", "ea_14_06", "ea_15_01", "ea_15_02"], "statement": "大脑是预测机器（四个概念）：①没有概念的信息落入体验盲区 ②身体内部被综合感知为内感受（好/不好×紧张/平静）③预测被证实就不再看输入，预测误差才带来学习 ④每次预测都先调动身体预算，能量在确认前就花出去了"}, {"id": "omc_1_4", "role": "judgment", "knowledge_ids": ["mech_det_16_01", "clm_det_16_02", "mech_det_16_03", "mech_det_17_04", "clm_det_17_06", "mech_det_18_04", "clm_det_19_03", "clm_det_25_03", "mech_det_25_04", "clm_det_25_05"], "evidence_anchor_ids": ["ea_16_01", "ea_16_02", "ea_16_03", "ea_17_04", "ea_17_06", "ea_18_04", "ea_19_03", "ea_25_03", "ea_25_04", "ea_25_05"], "statement": "核心：情绪是大脑用过往概念、结合当下情境，对内感受做出的预测。所以它①由概念塑造 ②随情境与目的变化（同样的胃痛可以是饿或恶心）③没有标准模板（快乐也有高唤醒和低唤醒）"}, {"id": "omc_1_5", "role": "practice", "knowledge_ids": ["bnd_det_20_01", "clm_det_20_07", "mech_det_22_02", "bnd_det_22_07", "clm_det_23_02", "mech_det_24_01", "clm_det_13_03", "clm_det_13_04"], "evidence_anchor_ids": ["ea_20_01", "ea_20_07", "ea_22_02", "ea_22_07", "ea_23_02", "ea_24_01", "ea_13_03", "ea_13_04"], "statement": "落地·主播五步（主播总结）：身心分离先查身体 → 身体预算协调 → 增加概念与正面经历 → 超量准备＋自我说服 → 同步上下文、扩充情绪词汇"}, {"id": "omc_1_6", "role": "practice", "knowledge_ids": ["mech_det_28_01", "mech_det_28_02", "mech_det_28_03", "clm_det_28_05", "mech_det_30_01", "mech_det_30_02", "mech_det_30_03", "mech_det_30_05", "clm_det_31_01", "clm_det_31_03", "clm_det_31_05"], "evidence_anchor_ids": ["ea_28_01", "ea_28_02", "ea_28_03", "ea_28_05", "ea_30_01", "ea_30_02", "ea_30_03", "ea_30_05", "ea_31_01", "ea_31_03", "ea_31_05"], "statement": "延伸·身心健康：长期预测出错→身体预算赤字→炎症恶性循环；抑郁像困在过去、焦虑像困在未来（作者推测）；最基本的是吃好睡好、社交、多运动"}, {"id": "omc_1_7", "role": "new_context", "knowledge_ids": ["clm_det_26_02", "bnd_det_26_05", "mech_det_26_07", "clm_det_27_01", "clm_det_27_04", "clm_det_27_05", "clm_det_27_06", "bnd_det_27_07"], "evidence_anchor_ids": ["ea_26_02", "ea_26_05", "ea_26_07", "ea_27_01", "ea_27_04", "ea_27_05", "ea_27_06", "ea_27_07"], "statement": "平行一句：社会文化同样参与构建情绪；改变情绪的责任在自己"}, {"id": "omc_1_8", "role": "boundary", "knowledge_ids": ["bnd_det_20_01", "clm_det_20_07", "mech_det_30_01", "mech_det_30_02", "mech_det_30_03", "mech_det_30_05"], "evidence_anchor_ids": ["ea_20_01", "ea_20_07", "ea_30_01", "ea_30_02", "ea_30_03", "ea_30_05"], "statement": "边界：情绪不是“假的”，也不是想控制就能控制；五步是主播经验，疾病部分不是医疗建议"}, {"id": "omc_1_9", "role": "conclusion", "knowledge_ids": ["clm_det_32_01", "clm_det_32_02", "clm_det_32_03", "bnd_det_32_04"], "evidence_anchor_ids": ["ea_32_01", "ea_32_02", "ea_32_03", "ea_32_04"], "statement": "结论：我们是自己情绪的建筑师"}